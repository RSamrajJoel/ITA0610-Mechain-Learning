# Experiment 11: Credit Score Classification
# Algorithm: Decision Tree

from sklearn.tree import DecisionTreeClassifier

# ---------------------------------
# Dataset
# ---------------------------------

X = [
    [12, 10, 1, 1],
    [10, 8, 2, 1],
    [8, 6, 2, 1],
    [6, 4, 3, 0],
    [4, 2, 4, 0],
    [15, 12, 1, 1],
    [7, 5, 3, 1],
    [5, 3, 4, 0],
    [11, 9, 2, 1],
    [3, 1, 5, 0]
]

y = [
    "Excellent",
    "Good",
    "Good",
    "Average",
    "Poor",
    "Excellent",
    "Average",
    "Poor",
    "Good",
    "Poor"
]

# ---------------------------------
# Create Decision Tree Model
# ---------------------------------

model = DecisionTreeClassifier(
    criterion="entropy",
    random_state=42
)

# Train the model
model.fit(X, y)

# ---------------------------------
# New Customer
# ---------------------------------

new_customer = [[9, 7, 2, 1]]

prediction = model.predict(new_customer)

# ---------------------------------
# Display Results
# ---------------------------------

print("======================================")
print("     CREDIT SCORE CLASSIFICATION")
print("       USING DECISION TREE")
print("======================================")

print("\nNew Customer Details:")
print("Annual Income       : 9 Lakhs")
print("Credit History      : 7 Years")
print("Existing Loans      : 2")
print("EMI Paid on Time    : Yes")

print("\nPredicted Credit Score:")
print(prediction[0])

print("\n======================================")
print("Decision Tree Classification Complete")
print("======================================")
