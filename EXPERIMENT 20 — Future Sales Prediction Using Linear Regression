# ==========================================================
# EXPERIMENT 20
# Future Sales Prediction using Linear Regression
# Dataset: Monthly Product Sales
# ==========================================================

from sklearn.linear_model import LinearRegression

# ----------------------------------------------------------
# 1. Dataset
# ----------------------------------------------------------

X = [
    [20, 2],
    [25, 2],
    [30, 3],
    [35, 3],
    [40, 4],
    [45, 4],
    [50, 5],
    [55, 5],
    [60, 6],
    [65, 6]
]

y = [
    250,
    290,
    340,
    390,
    450,
    510,
    580,
    640,
    710,
    780
]

# ----------------------------------------------------------
# 2. Create and Train Linear Regression Model
# ----------------------------------------------------------

model = LinearRegression()
model.fit(X, y)

# ----------------------------------------------------------
# 3. New Sample
# ----------------------------------------------------------

new_sample = [[48, 5]]

# ----------------------------------------------------------
# 4. Predict Future Sales
# ----------------------------------------------------------

prediction = model.predict(new_sample)

# ----------------------------------------------------------
# 5. Display Results
# ----------------------------------------------------------

print("=" * 55)
print("        FUTURE SALES PREDICTION")
print("          LINEAR REGRESSION")
print("=" * 55)

print("\nNew Input Details")
print("Advertising Budget : ₹48 Thousand")
print("Salespersons        : 5")

print("\nPredicted Future Sales : {:.2f} Units"
      .format(prediction[0]))

print("\n" + "=" * 55)
print("Sales Prediction Completed Successfully")
print("=" * 55)
