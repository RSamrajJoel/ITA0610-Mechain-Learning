# Experiment 10: Expectation Maximization (EM) Algorithm
# Dataset: Student Performance Clustering

from sklearn.mixture import GaussianMixture
import numpy as np

# -------------------------------
# Dataset
# -------------------------------
X = np.array([
    [2, 65],
    [3, 70],
    [4, 75],
    [5, 80],
    [6, 85],
    [7, 88],
    [8, 90],
    [9, 93],
    [10, 95],
    [11, 98]
])

# New sample
new_sample = np.array([[7, 89]])

# -------------------------------
# EM Model using Gaussian Mixture
# -------------------------------
model = GaussianMixture(
    n_components=2,
    random_state=42
)

model.fit(X)

# Cluster labels
clusters = model.predict(X)

# New sample cluster
new_cluster = model.predict(new_sample)

# -------------------------------
# Display Results
# -------------------------------
print("====================================")
print("   EXPECTATION MAXIMIZATION (EM)")
print("====================================")

print("\nDataset:")
print("Study Hours\tAttendance")

for i in range(len(X)):
    print(f"{X[i][0]}\t\t{X[i][1]}")

print("\nCluster Labels:")
print(clusters)

print("\nNew Sample:")
print("Study Hours = 7")
print("Attendance  = 89")

print("\nPredicted Cluster:")
print(new_cluster[0])

print("\n====================================")
print("EM Clustering Completed Successfully")
print("====================================")
