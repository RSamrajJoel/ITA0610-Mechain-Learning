# EXPERIMENT 17
# Mobile Price Prediction using Linear Regression
# ==========================================================

from sklearn.linear_model import LinearRegression

# ----------------------------------------------------------
# Dataset
# ----------------------------------------------------------

X = [
    [4, 64, 12],
    [4, 128, 16],
    [6, 128, 48],
    [6, 256, 50],
    [8, 128, 64],
    [8, 256, 64],
    [12, 256, 108],
    [12, 512, 108],
    [16, 512, 200],
    [16, 1024, 200]
]

y = [
    12000,
    15000,
    18000,
    22000,
    25000,
    30000,
    38000,
    45000,
    60000,
    75000
]

# ----------------------------------------------------------
# Create and Train Linear Regression Model
# ----------------------------------------------------------

model = LinearRegression()
model.fit(X, y)

# ----------------------------------------------------------
# New Mobile Specification
# ----------------------------------------------------------

new_mobile = [[8, 256, 108]]

# Predict price
prediction = model.predict(new_mobile)

# ----------------------------------------------------------
# Display Results
# ----------------------------------------------------------

print("=" * 55)
print("       MOBILE PRICE PREDICTION")
print("          LINEAR REGRESSION")
print("=" * 55)

print("\nNew Mobile Specifications")
print("RAM       : 8 GB")
print("Storage   : 256 GB")
print("Camera    : 108 MP")

print("\nPredicted Mobile Price : ₹{:.2f}"
      .format(prediction[0]))

print("\n" + "=" * 55)
print("Prediction Completed Successfully")
print("=" * 55)
